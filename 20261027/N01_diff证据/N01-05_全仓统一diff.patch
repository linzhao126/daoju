+def build(segs, new_event=True, hist=(100, 105, 110, 95, 102), extra_hist=()):
+    """segs = [(prog, n), ...] 椤哄簭鍐欏叆锛沶ew_event 鎺у埗鏈夋病鏈変汉鐐硅繃銆屾崲鏂板垁銆?""
+    c = sqlite3.connect(':memory:')
