+INF = os.path.join(BASE, '02_婧愪唬鐮佷笌閰嶇疆', 'source', 'influx_source.py')
+
+PASS = FAIL = 0
+
+
+def ck(name, cond, detail=''):
+    global PASS, FAIL
+    if cond:
+        PASS += 1
+        print('  PASS  %-58s %s' % (name, detail))
+    else:
+        FAIL += 1
+        print('  FAIL  %-58s %s' % (name, detail))
+
+
+def lag_replica(pairs, limit_day=True):
+    """澶嶅埢 lag_stats 鐨勮繃婊や笌缁熻锛堝惈璐熷€间笌 >1 澶╀涪寮冿級"""
+    vals, neg, stale = [], 0, 0
+    for ts, recv in pairs:
+        if recv is None:
+            continue
+        d = recv - ts
+        if d < 0:
+            neg += 1
+            continue
+        if limit_day and d > 86400:
+            stale += 1
+            continue
+        vals.append(d)
+    if not vals:
+        return dict(n=0, neg=neg, stale=stale)
+    v = sorted(vals)
+    n = len(v)
+    med = (v[n // 2] if n % 2 else (v[n // 2 - 1] + v[n // 2]) / 2.0)
+    k = min(n - 1, int(round(0.95 * (n - 1))))   # 涓?np.percentile 绾挎€ф彃鍊艰繎浼?+    return dict(n=n, neg=neg, stale=stale, median=med, p95=v[k], max=v[-1], min=v[0])
+
+
