+             (0, 90000.0),                                  # >1 澶?鈫?涓㈠純
+             (0, None)]                                     # NULL 鈫?璺宠繃
+    r = lag_replica(pairs)
+    ck('T6.1 n=4锛圢ULL 涓庡紓甯稿€奸兘琚帓闄わ級', r['n'] == 4, str(r))
+    ck('T6.2 neg=1', r['neg'] == 1, str(r['neg']))
+    ck('T6.3 stale=1', r['stale'] == 1, str(r['stale']))
+    ck('T6.4 median=7.0锛?,5,9,20 鐨勪腑浣嶏級', abs(r['median'] - 7.0) < 1e-9, str(r['median']))
+    ck('T6.5 max=20.0 / min=3.0', r['max'] == 20.0 and r['min'] == 3.0,
+       'max=%s min=%s' % (r['max'], r['min']))
+    r2 = lag_replica([(0, None), (0, None)])
+    ck('T6.6 鍏?NULL 鏃?n=0 涓斾笉鎶涘紓甯?, r2['n'] == 0, str(r2))
+
+    print('\n' + '=' * 84)
